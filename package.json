{
  "name": "@hankei6km/gas-notion2content",
  "version": "0.6.0",
  "description": "Notion のデータベースを変換しダウンロードする GAS ライブラリー",
  "author": "hankei6km <hankei6km@gmail.com> (https://github.com/hankei6km)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hankei6km/gas-notion2content.git"
  },
  "bugs": {
    "url": "https://github.com/hankei6km/gas-notion2content/issues"
  },
  "keywords": [
    "gas",
    "notion",
    "hast",
    "html"
  ],
  "files": [
    "index.d.ts"
  ],
  "main": "",
  "type": "module",
  "types": "index.d.ts",
  "scripts": {
    "setup:clasp": "bash scripts/setup-clasp.sh && bash scripts/setup-clasprc.sh",
    "cleanup:clasp": "bash scripts/cleanup-clasp.sh",
    "clean": "npm run clean:build && npm run clean:test",
    "clean:build": "rm -rf index.d.ts build/*",
    "clean:test": "rm -rf test/build",
    "build": "npm run clean:build && bash scripts/build.sh",
    "push": "bash scripts/clasp-with-auth.sh push --force",
    "deploy": "bash scripts/clasp-with-auth.sh deploy",
    "test": "node --experimental-test-module-mocks --experimental-strip-types --test",
    "test:coverage": "npm run test -- --experimental-test-coverage",
    "test:build": "npm run clean:test && npm run build && bash scripts/test-build.sh && npm run test",
    "posttest:build": "npm run clean:test",
    "lint:type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@hankei6km/files-to-licenses": "^0.1.1",
    "@types/google-apps-script": "^2.0.0",
    "@types/node": "^26.0.0",
    "esbuild": "^0.28.0",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@notionhq/client": "^4.0.0",
    "hast-util-sanitize": "^5.0.1",
    "notion2content": "^0.5.5"
  }
}
